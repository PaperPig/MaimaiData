<resources>
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:textColor">@color/textColor</item>
    </style>

    <style name="ScoreTypeInputStyle">
        <item name="android:inputType">number</item>
        <item name="android:gravity">center</item>
    </style>


    <style name="DXScoreAchievementStyle">
        <item name="android:gravity">center</item>
    </style>

    <style name="SearchCheckBoxStyle">
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/mmd_checkbox_version_selector</item>
        <item name="android:padding">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="ButtonStyle">
        <item name="android:backgroundTint">@color/colorPrimary</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="MainBottomNavStyle" parent="Widget.Material3.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/MainBottomNavActiveIndicator</item>
        <item name="itemIconTint">@drawable/nav_bar_text_color_selector</item>
        <item name="itemRippleColor">@color/nav_bar_ripple</item>
        <item name="itemIconSize">24dp</item>
        <item name="itemPaddingTop">8dp</item>
        <item name="itemPaddingBottom">8dp</item>
        <item name="labelVisibilityMode">unlabeled</item>
        <item name="android:minHeight">48dp</item>
        <item name="backgroundTint">@color/nav_bar_bg</item>
        <item name="android:background">@color/nav_bar_bg</item>
    </style>

    <style name="MainBottomNavActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/nav_bar_indicator</item>
        <item name="android:width">56dp</item>
        <item name="android:height">32dp</item>
    </style>


</resources>