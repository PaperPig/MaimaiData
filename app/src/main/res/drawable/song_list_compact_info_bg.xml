<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#55FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFF" />
                    <corners android:radius="10dp" />
                </shape>
            </item>

            <item
                android:id="@+id/song_list_bg"
                android:bottom="1dp"
                android:left="1dp"
                android:right="1dp"
                android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#09C8D4" />
                    <corners android:radius="9dp" />
                </shape>
            </item>

            <item
                android:id="@+id/song_list_inner_stroke"
                android:bottom="3dp"
                android:left="3dp"
                android:right="3dp"
                android:top="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="7dp" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#09C8D4" />
                </shape>
            </item>

            <item
                android:id="@+id/song_list_stroke"
                android:bottom="1dp"
                android:left="1dp"
                android:right="1dp"
                android:top="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="9dp" />
                    <stroke
                        android:width="2dp"
                        android:color="#09C8D4" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
